{
  "name": "GMCI Editorial",
  "dataColors": [
    "#0F2B46",
    "#1F6F7A",
    "#D96B2B",
    "#7FC4C9",
    "#C8C6C4",
    "#E044A7",
    "#744EC2",
    "#D9B300"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1F6F7A",
  "good": "#107C10",
  "neutral": "#D9A441",
  "bad": "#C0504D",
  "maximum": "#0F2B46",
  "minimum": "#F3F2F1",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#0F2B46"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#252423"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#605E5C"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#0F2B46"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "radius": 4
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F2B46"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "BottomCenter",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#605E5C"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#0F2B46"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#605E5C"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEBE9"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FAFAFA"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FCFCFC"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "fontSize": 10,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}
